  "map": {
    "columns": [
      {
        "qFieldDefs": [
          "={<cdTipoObra = {15,30,33,35,37,41,45}>} [_skObra]"
        ],
        "qFieldLabels": [
          "identificador da obra"
        ],
        "qNullSuppression": true,
        "type": "dimension"
      },
      {
        "qFieldDefs": [
          "[Tipo da obra]"
        ],
        "qFieldLabels": [
          "Tipo da obra"
        ],
        "qNullSuppression": true,
        "type": "dimension"
      },
      {
        "qFieldDefs": [
          "Contrato"
        ],
        "qFieldLabels": [
          "Contrato"
        ],
        "qNullSuppression": true,
        "type": "dimension"
      },
      {
        "qFieldDefs": [
          "cdLote"
        ],
        "qFieldLabels": [
          "Código da obra"
        ],
        "type": "dimension"
      },
      {
        "qFieldDefs": [
          "[Local da obra]"
        ],
        "qFieldLabels": [
          "Local da obra"
        ],
        "qNullSuppression": true,
        "type": "dimension"
      },
      {
        "qDef": "num(Sum({<[_skObra] = P(_skObra), urlFoto=, [tpValor] = {'PI'}, [cdTipoCalculoMedicao] = {1,2,3}, [flMedicaoAprovada] = {'S'}>} valorMedicao) / Sum(valorServicoObra), '#.##0,00%')",
        "qLabel": "Execução",
        "type": "measure"
      },
      {
        "qDef": "Sum(valorServicoObra)",
        "qLabel": "Valor",
        "type": "measure"
      },
      {
        "qDef": "FirstSortedValue(DISTINCT urlFoto, -dataFotoDiarioObra)",
        "qLabel": "Foto",
        "type": "measure"
      },
      {
        "qDef": "Only([Descrição da obra])",
        "qLabel": "Descrição da obra",
        "type": "measure"
      }
    ]
  },
  "mapDetails": {
    "detailsColumns": [
      {
        "qDef": "Only({<[_skObra]={$(vObraSelecionada)}>} _skObra)",
        "qLabel": "identificador da obra",
        "type": "measure"
      },
      {
        
        "qDef": "Concat(DISTINCT {<[_skObra]={$(vObraSelecionada)}>} Contrato, ', ')",
        "qLabel": "Contrato",
        "type": "measure"
      },
      {
        "qDef": "Only({<[_skObra]={$(vObraSelecionada)}>} [Descrição da obra])",
        "qLabel": "Descrição da obra",
        "type": "measure"
      },
      {
        "qDef": "Only({<[_skObra]={$(vObraSelecionada)}>} [Tipo da obra])",
        "qLabel": "Tipo da obra",
        "type": "measure"
      },
      {
        "qDef": "Only({<[_skObra]={$(vObraSelecionada)}>} [Classificação da obra])",
        "qLabel": "Classificação da obra",
        "type": "measure"
      },
      {
        "qDef": "Only({<[_skObra]={$(vObraSelecionada)}>} [Situação atual da obra])",
        "qLabel": "Situação atual da obra",
        "type": "measure"
      },
      {
        "qDef": "Date(Only({<[_skObra]={$(vObraSelecionada)}>} [Data fim execução da obra]))",
        "qLabel": "Data fim execução da obra",
        "type": "measure"
      },
      {
        "qDef": "Num(Sum({<[_skObra]={$(vObraSelecionada)}>} valorServicoObra), 'R$ #.##0,00')",
        "qLabel": "Valor da obra",
        "type": "measure"
      },
      {
        "qDef": "Num(Sum({<[_skObra]={$(vObraSelecionada)}, urlFoto=, [tpValor] = {'PI'}, [cdTipoCalculoMedicao] = {1,2,3}, [flMedicaoAprovada] = {'S'}>} valorMedicao) / Sum({<[_skObra]={$(vObraSelecionada)}>} valorServicoObra) * 100, '#.##0,00') & '%'",
        "qLabel": "% Execução",
        "type": "measure"
      },
      {
        "qDef": "Num(Sum({<[_skObra]={$(vObraSelecionada)}, _skTempo={\"<$(=Date(MonthStart(Today()), 'YYYYMMDD'))\"}, cdTipoObra = {15, 30, 33, 35, 37, 41, 45}, urlFoto=>} valorCronograma) / Sum({<[_skObra]={$(vObraSelecionada)}, urlFoto=>} valorServicoObra) * 100, '#.##0,00') & '%'",
        "qLabel": "% Execução esperada",
        "type": "measure"
      },
      {
        "qDef": "If(Count({<[_skObra]={$(vObraSelecionada)}>} geoTrechoObra) > 0, '[' & Concat({<[_skObra]={$(vObraSelecionada)}>} geoTrechoObra, ',') & ']', Only({<[_skObra]={$(vObraSelecionada)}>} [Local da obra]))",
        "qLabel": "Trecho",
        "type": "measure"
      },
      {
        "qDef": "If(Count({<[_skObra]={$(vObraSelecionada)}>} geoTrecho) > 0, '[' & Concat({<[_skObra]={$(vObraSelecionada)}>} geoTrecho, ',') & ']', Only({<[_skObra]={$(vObraSelecionada)}>} [Local da obra]))",
        "qLabel": "GeoTrecho",
        "type": "measure"
      },
      {
        "qDef": "Only({<[_skObra]={$(vObraSelecionada)}>} [Sigla da rodovia])",
        "qLabel": "SiglaRodovia",
        "type": "measure"
      }
    ],
    "detailsLineChart": {
      "columns": [
        {
          "qFieldDefs": [
            "DEANOMES"
          ],
          "type": "dimension"
        },
        {
          "qDef": "Num(RangeSum(Above(Sum({<urlFoto=, cdTipoObra = {15, 30, 33, 35, 37, 41, 45}, [_skObra]={$(vObraSelecionada)}>} valorCronograma),0,RowNo()))/Sum({<urlFoto=, [_skObra]={$(vObraSelecionada)}>} valorServicoObra) * 100, '#.##0,00') & '%'",
          "qLabel": "Previsto (cronograma)",
          "type": "measure"
        },
        {
          "qDef": "=Num(RangeSum(Above(Sum({<urlFoto=, _skTempo={\"<$(=Date(MonthStart(Today()),'YYYYMMDD'))\"}, [tpValor]={\"PI\"}, [cdTipoCalculoMedicao]={1,2,3}, [flMedicaoAprovada]={\"S\"}, cdTipoObra={15,30,33,35,37,41,45}, [_skObra]={'$(vObraSelecionada)'}>} valorMedicao),0,RowNo())) / Sum({<urlFoto=, _skTempo={\"<$(=Date(MonthStart(Today()),'YYYYMMDD'))\"}, [_skObra]={'$(vObraSelecionada)'}>} valorServicoObra), '0,00%')",
          "qLabel": "Realizado (medição)",
          "type": "measure"
        }
      ]
    },
    "photoColumns": [
      {
        "qFieldDefs": [
          "urlFoto"
        ],
        "qFieldLabels": [
          "URL da foto"
        ],
        "sortingPriority": 2,
        "qNullSuppression": true,
        "type": "dimension"
      },
      {
        "qFieldDefs": [
          "localFoto"
        ],
        "qFieldLabels": [
          "Local da foto"
        ],
        "type": "dimension"
      },
      {
        "qFieldDefs": [
          "[dataFotoDiarioObra]"
        ],
        "qFieldLabels": [
          "Data da foto"
        ],
        "type": "dimension",
        "sortingPriority": 0,
        "qSortCriterias": [
          {
            "qSortByState": 0,
            "qSortByFrequency": 0,
            "qSortByNumeric": 0,
            "qSortByAscii": 0,
            "qSortByLoadOrder": 1,
            "qSortByExpression": 0,
            "qExpression": {
              "qv": ""
            },
            "qSortByGreyness": 0
          }
        ]
      },
      {
        "qFieldDefs": [
          "nmServicoFoto"
        ],
        "qFieldLabels": [
          "Serviço da foto"
        ],
        "type": "dimension"
      },
      {
        "qDef": "Sum({<_skObra={$(vObraSelecionada)}>}1)",
        "qLabel": "Filtro obra",
        "type": "measure"
      }
    ]
  },
