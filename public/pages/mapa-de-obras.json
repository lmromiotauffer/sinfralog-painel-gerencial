  "kpis": [
    {
      "label": "Quantidade de Obras",
      "title": "='Quantidade de obras'",
      "expression": "num(count(distinct {<cdTipoObra = {15, 30, 33, 35, 37, 41, 45}>} [_skObra]), '#.##0')",
      "extraAttributes": {
        "icon": "='ellipse-boxes'"
      }
    },
    {
      "label": "Valor da(s) obra(s)",
      "title": "Valor da(s) obra(s)",
      "expression": "'R$' & num(Sum(valorServicoObra), '#.##0,00')",
      "extraAttributes": {
        "icon": "='ellipse-coins'"
      }
    },
    {
      "label": "Medido (PI + Acréscimo e Desconto)",
      "title": "Medido (PI + Acréscimo e Desconto)",
      "expression": "'R$' & num(Sum({<[_skObra] = P(_skObra), [tpValor] = {\"PI\"}, [cdTipoCalculoMedicao] = {1,2,3}, [flMedicaoAprovada] = {\"S\"}, cdTipoObra = {15, 30, 33, 35, 37, 41, 45}, urlFoto=>} valorMedicao), '#.##0,00')",
      "extraAttributes": {
        "icon": "='ellipse-layers'"
      }
    },
    {
      "label": "% Execução",
      "title": "='% Execução'",
      "expression": "num(Sum({<[_skObra] = P(_skObra), [tpValor] = {\"PI\"}, [cdTipoCalculoMedicao] = {1,2,3}, [flMedicaoAprovada] = {\"S\"}, cdTipoObra = {15, 30, 33, 35, 37, 41, 45}, urlFoto=>} valorMedicao)/Sum(valorServicoObra), '0,00%')",
      "extraAttributes": {
        "icon": "='ellipse-percent-diamond'"
      }
    },
    {
      "label": "Diferença previsto x realizado (p.p.)",
      "title": "Diferença previsto x realizado (p.p.)",
      "expression": "num(Round((Sum({<[_skObra] = P(_skObra), [tpValor] = {\"PI\"}, [cdTipoCalculoMedicao] = {1,2,3}, [flMedicaoAprovada] = {\"S\"}, cdTipoObra = {15, 30, 33, 35, 37, 41, 45}, urlFoto=>} valorMedicao)/Sum({<[_skObra] = P(_skObra), urlFoto=>} valorServicoObra))-((Sum({<[_skObra] = P(_skObra), _skTempo={\"<$(=Date(MonthStart(Today()), 'YYYYMMDD'))\"}, cdTipoObra = {15, 30, 33, 35, 37, 41, 45}, urlFoto=>} valorCronograma)/Sum({<[_skObra] = P(_skObra), urlFoto=>} valorServicoObra))), 0.0001) * 100, '#.##0,00')",
      "extraAttributes": {
        "icon": "='ellipse-blocks'"
      }
    },
    {
      "label": "Medido (PI + R + Acréscimo e Desconto)",
      "title": "Medido (PI + R + Acréscimo e Desconto)",
      "expression": "'R$' & num(Sum({<[_skObra] = P(_skObra), [cdTipoCalculoMedicao] = {1,2,3}, [flMedicaoAprovada] = {\"S\"}, cdTipoObra = {15, 30, 33, 35, 37, 41, 45}, urlFoto=>} valorMedicao), '#.##0,00')",
